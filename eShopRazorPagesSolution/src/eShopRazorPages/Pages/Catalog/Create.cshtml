@page
@model eShopRazorPages.Pages.Catalog.CreateModel
@{
    ViewData["Title"] = "Create";
}

<h2 class="esh-body-title">Create</h2>

<form method="post">
    <div class="form-horizontal">
        <div class="form-group">
            <label asp-for="Input.Name" class="control-label col-md-2">Name</label>
            <div class="col-md-3">
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Description" class="control-label col-md-2">Description</label>
            <div class="col-md-3">
                <input asp-for="Input.Description" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.CatalogBrandId" class="control-label col-md-2">Brand</label>
            <div class="col-md-3">
                <select asp-for="Input.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
                <span asp-validation-for="Input.CatalogBrandId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.CatalogTypeId" class="control-label col-md-2">Type</label>
            <div class="col-md-3">
                <select asp-for="Input.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
                <span asp-validation-for="Input.CatalogTypeId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Price" class="control-label col-md-2">Price</label>
            <div class="col-md-3">
                <input asp-for="Input.Price" class="form-control" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Picture name</label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Stock" class="control-label col-md-2">Stock</label>
            <div class="col-md-3">
                <input asp-for="Input.Stock" class="form-control" />
                <span asp-validation-for="Input.Stock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Restock" class="control-label col-md-2">Restock</label>
            <div class="col-md-3">
                <input asp-for="Input.Restock" class="form-control" />
                <span asp-validation-for="Input.Restock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Maxstock" class="control-label col-md-2">Max stock</label>
            <div class="col-md-3">
                <input asp-for="Input.Maxstock" class="form-control" />
                <span asp-validation-for="Input.Maxstock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a href="~/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <input type="submit" value="[ Create ]" class="btn esh-button esh-button-primary" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
