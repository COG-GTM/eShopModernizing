@model EShop.Catalog.Contracts.CatalogItem
<dt>Name</dt>
<dd><span>@Model.Name</span></dd>

<dt>Description</dt>
<dd><span>@Model.Description</span></dd>

<dt>Brand</dt>
<dd><span>@Model.CatalogBrand!.Brand</span></dd>

<dt>Type</dt>
<dd><span>@Model.CatalogType!.Type</span></dd>

<dt>Price</dt>
<dd><span class="esh-price">@WebFormsCatalogForm.FormatPrice(Model.Price)</span></dd>

<dt>Picture name</dt>
<dd><span>@Model.PictureFileName</span></dd>

<dt>Stock</dt>
<dd><span>@Model.AvailableStock</span></dd>

<dt>Restock</dt>
<dd><span>@Model.RestockThreshold</span></dd>

<dt>Max stock</dt>
<dd><span>@Model.MaxStockThreshold</span></dd>
