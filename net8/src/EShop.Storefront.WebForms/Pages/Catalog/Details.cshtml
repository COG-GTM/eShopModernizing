@page
@model DetailsModel
@{
    ViewData["Title"] = "Details";
}
<h2 class="esh-body-title">Details</h2>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src="/Pics/@Model.Product.PictureFileName" />
        <dl class="col-md-6 dl-horizontal">
            <partial name="_ProductSummary" model="Model.Product" />
        </dl>
    </div>

    <div class="form-actions no-color esh-link-list">
        <a class="esh-link-item" href="@Url.Content($"~/Catalog/Edit/{Model.Product.Id}")">Edit</a>
        |
        <a class="esh-link-item" href="@LegacyClientUrl.Resolve(HttpContext, "~")">Back to list</a>
    </div>
</div>
