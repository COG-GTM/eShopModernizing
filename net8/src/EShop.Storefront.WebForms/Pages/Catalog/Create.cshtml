@page
@model CreateModel
@{
    ViewData["Title"] = "Create";
    var f = Model.Form;
    const string p = WebFormsCatalogForm.Prefix;
    string? V(string? v) => string.IsNullOrEmpty(v) ? null : v;
}
<h2 class="esh-body-title">Create</h2>

<div>
    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-2">Name</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Name)" name="@(p)Name" id="ctl00_MainContent_Name" class="form-control" />
                <partial name="_Validator" model="f.ErrorFor(nameof(f.Name))" view-data='new ViewDataDictionary(ViewData) { ["ValidatorCss"] = "field-validation-valid text-danger" }' />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Description</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Description)" name="@(p)Description" id="ctl00_MainContent_Description" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Brand</label>
            <div class="col-md-3">
                <select name="@(p)Brand" id="ctl00_MainContent_Brand" class="form-control">
                    @foreach (var brand in Model.Brands)
                    {
                        <option selected="@(f.Brand == brand.Id.ToString())" value="@brand.Id">@brand.Brand</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Type</label>
            <div class="col-md-3">
                <select name="@(p)Type" id="ctl00_MainContent_Type" class="form-control">
                    @foreach (var type in Model.Types)
                    {
                        <option selected="@(f.Type == type.Id.ToString())" value="@type.Id">@type.Type</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Price</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Price)" name="@(p)Price" id="ctl00_MainContent_Price" class="form-control" />
                <partial name="_Validator" model="f.ErrorFor(nameof(f.Price))" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Picture name</label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Stock</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Stock)" name="@(p)Stock" id="ctl00_MainContent_Stock" class="form-control" />
                <partial name="_Validator" model="f.ErrorFor(nameof(f.Stock))" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Restock</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Restock)" name="@(p)Restock" id="ctl00_MainContent_Restock" class="form-control" />
                <partial name="_Validator" model="f.ErrorFor(nameof(f.Restock))" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Max stock</label>
            <div class="col-md-3">
                <input type="text" value="@V(f.Maxstock)" name="@(p)Maxstock" id="ctl00_MainContent_Maxstock" class="form-control" />
                <partial name="_Validator" model="f.ErrorFor(nameof(f.Maxstock))" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a class="btn esh-button esh-button-secondary" href="@LegacyClientUrl.Resolve(HttpContext, "~")">[ Cancel ]</a>
                <input type="submit" name="@(p + CreateModel.CreateButtonId)" value="[ Create ]" class="btn esh-button esh-button-primary" />
            </div>
        </div>
    </div>
</div>
