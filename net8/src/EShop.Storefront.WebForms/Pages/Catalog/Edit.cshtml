@page
@model EditModel
@{
    ViewData["Title"] = "Edit";
    var f = Model.Form;
    const string p = WebFormsCatalogForm.Prefix;
    string? V(string? v) => string.IsNullOrEmpty(v) ? null : v;
}
<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <form method="post">
        <div class="row">
            <img class="col-md-6 esh-picture" src="/Pics/@f.PictureFileName" />
            <div class="col-md-6 form-horizontal">

                <div class="form-group">
                    <label class="control-label col-md-4">Name</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Name)" name="@(p)Name" id="ctl00_MainContent_Name" class="form-control" />
                        <partial name="_Validator" model="f.ErrorFor(nameof(f.Name))" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Description</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Description)" name="@(p)Description" id="ctl00_MainContent_Description" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Brand</label>
                    <div class="col-md-8">
                        <select name="@(p)BrandDropDownList" id="ctl00_MainContent_BrandDropDownList" class="form-control">
                            @foreach (var brand in Model.Brands)
                            {
                                <option selected="@(f.Brand == brand.Id.ToString())" value="@brand.Id">@brand.Brand</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Type</label>
                    <div class="col-md-8">
                        <select name="@(p)TypeDropDownList" id="ctl00_MainContent_TypeDropDownList" class="form-control">
                            @foreach (var type in Model.Types)
                            {
                                <option selected="@(f.Type == type.Id.ToString())" value="@type.Id">@type.Type</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Price</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Price)" name="@(p)Price" id="ctl00_MainContent_Price" class="form-control" />
                        <partial name="_Validator" model="f.ErrorFor(nameof(f.Price))" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Picture name</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.PictureFileName)" readonly="ReadOnly" name="@(p)PictureFileName" id="ctl00_MainContent_PictureFileName" title="Not allowed for edition" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Stock</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Stock)" name="@(p)Stock" id="ctl00_MainContent_Stock" class="form-control" />
                        <partial name="_Validator" model="f.ErrorFor(nameof(f.Stock))" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Restock</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Restock)" name="@(p)Restock" id="ctl00_MainContent_Restock" class="form-control" />
                        <partial name="_Validator" model="f.ErrorFor(nameof(f.Restock))" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Max stock</label>
                    <div class="col-md-8">
                        <input type="text" value="@V(f.Maxstock)" name="@(p)Maxstock" id="ctl00_MainContent_Maxstock" class="form-control" />
                        <partial name="_Validator" model="f.ErrorFor(nameof(f.Maxstock))" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 text-right esh-button-actions">
                        <a class="btn esh-button esh-button-secondary" href="@LegacyClientUrl.Resolve(HttpContext, "~")">[ Cancel ]</a>
                        <input type="submit" name="@(p + EditModel.SaveButtonId)" value="[ Save ]" class="btn esh-button esh-button-primary" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
