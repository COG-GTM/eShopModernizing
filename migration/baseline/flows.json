{
  "version": 1,
  "description": "Every user/API flow of the legacy MVC (port 5100) and WebForms (port 5101) apps, replayed in this order per app. Group 'read' flows are state-independent on a fresh app; group 'mutate' flows run afterwards in order against the singleton mock catalog. POST flows GET form.from first (same cookie session), collect every successful control (antiforgery / viewstate tokens obtained dynamically), drop form.drop, overlay form.fields and post to the form's action (or request.path when path_is_explicit). snapshot=true flows are followed by a full-catalog data-state capture (data_state_paths). compare overrides the default projection (status + mime + location + normalised body; body ignored for 3xx redirects and status >= 400).",
  "apps": {
    "mvc": {
      "legacy_url": "http://localhost:5100",
      "migrated_url": "http://localhost:5200"
    },
    "webforms": {
      "legacy_url": "http://localhost:5101",
      "migrated_url": "http://localhost:5201"
    }
  },
  "data_state_paths": {
    "mvc": "/Catalog/Index?pageSize=1000&pageIndex=0",
    "webforms": "/Default/index/0/size/1000"
  },
  "flows": [
    {
      "id": "mvc-index-root",
      "app": "mvc",
      "order": 1,
      "group": "read",
