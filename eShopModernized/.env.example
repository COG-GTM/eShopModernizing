# Copy to .env and adjust as needed. docker compose reads .env from this folder automatically.

# SQL Server 'sa' password. Must satisfy SQL Server complexity rules
# (8+ chars, at least 3 of: upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=Pass@word1

# Database name used by the app and created/seeded by db-init.
ESHOP_DB_NAME=Microsoft.eShopOnContainers.Services.CatalogDb

# Host ports.
ESHOP_WEB_PORT=5002
ESHOP_SQL_PORT=5433

# Set to true to run the app against the in-memory mock catalog instead of SQL Server.
ESHOP_USE_MOCK_DATA=false
