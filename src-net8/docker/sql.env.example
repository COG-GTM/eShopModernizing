# Copy to src-net8/docker/sql.env (git-ignored) or export the variables in your shell, then:
#   docker compose -f src-net8/docker-compose.yml --env-file src-net8/docker/sql.env up -d --wait
# COMPOSE_PROFILES=sql makes the SQL Server stack the default profile for that command; pass
# `--profile mock` instead for the in-memory parity stack (the CLI flag overrides COMPOSE_PROFILES).
COMPOSE_PROFILES=sql
# SQL Server 2022 sa password: >= 8 chars with three of upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=
# Per-service UseMockData overrides for the sql profile (default false = SQL Server via EF Core).
MVC_USE_MOCK_DATA=false
WEBFORMS_USE_MOCK_DATA=false
