anger\" data-valmsg-for=\"RestockThreshold\" data-valmsg-replace=\"true\"></span>\n            </div>\n        </div>\n\n        <div class=\"form-group\">\n            <label class=\"control-label col-md-2\" for=\"MaxStockThreshold\">Max stock</label>\n            <div class=\"col-md-3\">\n                <input class=\"form-control text-box single-line\" data-val=\"true\" data-val-number=\"The field Max stock must be a number.\" data-val-range=\"The field Max stock must be between 0 and 10 million.\" data-val-range-max=\"10000000\" data-val-range-min=\"0\" data-val-required=\"The Max stock field is required.\" id=\"MaxStockThreshold\" name=\"MaxStockThreshold\" type=\"number\" value=\"0\" />\n                <span class=\"field-validation-valid text-danger\" data-valmsg-for=\"MaxStockThreshold\" data-valmsg-replace=\"true\"></span>\n            </div>\n        </div>\n\n        <div class=\"form-group\">\n            <div class=\"col-md-offset-2 col-md-3 text-right esh-button-actions\">\n                <a class=\"btn esh-button esh-button-secondary\" href=\"/\">[ Cancel ]</a>\n                <input type=\"submit\" value=\"[ Create ]\" class=\"btn esh-button esh-button-primary\" />\n            </div>\n        </div>\n    </div>\n</form>\n<div>\n    \n</div>\n\n\n\n    <footer class=\"esh-app-footer\">\n        <div class=\"container\">\n            <article class=\"row\">\n                <section class=\"col-sm-6\">\n                    <img class=\"esh-app-footer-brand\" src=\"/images/brand_dark.png\" />\n                </section>\n                <section class=\"col-sm-6\">\n                    <img class=\"esh-app-footer-text hidden-xs\" src=\"/images/main_footer_text.png\" width=\"335\" height=\"26\" alt=\"footer text image\" />\n                    <br />\n\n                    <small>{{HOST}}, {{DATETIME}}</small>\n                </section>\n                \n            </article>\n        </div>\n    </footer>\n\n    <script src=\"/Scripts/jquery-3.3