ription\" name=\"Description\" type=\"text\" value=\"\" />\n                <span class=\"field-validation-valid text-danger\" data-valmsg-for=\"Description\" data-valmsg-replace=\"true\"></span>\n            </div>\n        </div>\n\n        <div class=\"form-group\">\n            <label class=\"control-label col-md-2\" for=\"CatalogBrandId\">Brand</label>\n            <div class=\"col-md-3\">\n                <select class=\"form-control\" id=\"CatalogBrandId\" name=\"CatalogBrandId\"><option value=\"1\">Azure</option>\n<option value=\"2\">.NET</option>\n<option value=\"3\">Visual Studio</option>\n<option value=\"4\">SQL Server</option>\n<option value=\"5\">Other</option>\n</select>\n                <span class=\"field-validation-valid text-danger\" data-valmsg-for=\"CatalogBrandId\" data-valmsg-replace=\"true\"></span>\n            </div>\n        </div>\n\n        <div class=\"form-group\">\n            <label class=\"control-label col-md-2\" for=\"CatalogTypeId\">Type</label>\n            <div class=\"col-md-3\">\n                <select class=\"form-control\" id=\"CatalogTypeId\" name=\"CatalogTypeId\"><option value=\"1\">Mug</option>\n<option value=\"2\">T-Shirt</option>\n<option value=\"3\">Sheet</option>\n<option value=\"4\">USB Memory Stick</option>\n</select>\n                <span class=\"field-validation-valid text-danger\" data-valmsg-for=\"CatalogTypeId\" data-valmsg-replace=\"true\"></span>\n            </div>\n        </div>\n\n        <div class=\"form-group\">\n            <label class=\"control-label col-md-2\" for=\"Price\">Price</label>\n            <div class=\"col-md-3\">\n                <input class=\"form-control text-box single-line\" data-val=\"true\" data-val-number=\"The field Price must be a number.\" data-val-range=\"The field Price must be between 0 and 1000000.\" data-val-range-max=\"1000000\" data-val-range-min=\"0\" data-val-regex=\"The field Price must be a positive number with maximum two decimals.\" data-val-regex-pattern=\"^\