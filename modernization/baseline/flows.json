{
 "version": 1,
 "description": "Declarative legacy flows; see modernization/CONTRACT.md. Sequences run in order; restart=true restarts the app (fresh mock data) first.",
 "apps": {
  "mvc": {
   "legacy_port": 5100,
   "target_port": 5200,
   "snapshot_items": "/?pageSize=1000&pageIndex=0",
   "snapshot_lookups": "/Catalog/Create"
  },
  "webforms": {
   "legacy_port": 5101,
   "target_port": 5201,
   "snapshot_items": "/Default/index/0/size/1000",
   "snapshot_lookups": "/Catalog/Create"
  }
 },
 "sequences": [
  {
   "id": "mvc-cold-reads",
   "app": "mvc",
   "restart": true,
   "description": "Right after a restart, before any list page has been rendered (mock navigation properties not yet composed, quirk Q4).",
   "flows": [
    {
     "id": "mvc-details-cold-12",
     "method": "GET",
     "path": "/Catalog/Details/12",
     "description": "Details of an item before any list render: Brand/Type render empty in mock mode",
     "quirk": "Q4"
    },
    {
     "id": "mvc-edit-cold-11",
     "method": "GET",
     "path": "/Catalog/Edit/11",
     "description": "Edit form before any list render",
     "quirk": "Q4"
    },
    {
     "id": "mvc-delete-cold-10",
     "method": "GET",
     "path": "/Catalog/Delete/10",
     "description": "Delete confirmation before any list render",
     "quirk": "Q4"
    }
   ]
  },
  {
   "id": "mvc-reads",
   "app": "mvc",
   "restart": false,
   "description": "Read-only flows (continues after mvc-cold-reads).",
   "flows": [
    {
     "id": "mvc-index-root",
     "method": "GET",
     "path": "/",
     "description": "Default list (pageSize 10, pageIndex 0)"
    },
    {
     "id": "mvc-index-catalog",
     "method": "GET",
     "path": "/Catalog",
     "description": "Controller default action"
    },
    {
     "id": "mvc-index-catalog-index",
     "method": "GET",
     "path": "/Catalog/Index",
     "description": "Explicit action"
    },
    {
     "id": "mvc-index-size5",
     "method": "GET",
     "path": "/?pageSize=5",
     "description": "Page size 5"
    },
    {
     "id": "mvc-index-size5-page1",
     "method": "GET",
     "path": "/?pageSize=5&pageIndex=1",
     "description": "Second page of 5"
    },
    {
     "id": "mvc-index-size5-page2",
     "method": "GET",
     "path": "/?pageSize=5&pageIndex=2",
     "description": "Last partial page"
    },
    {
     "id": "mvc-index-size10-page1",
     "method": "GET",
     "path": "/Catalog/Index?pageSize=10&pageIndex=1",
     "description": "Second page of 10 (2 items)"
    },
    {
     "id": "mvc-index-beyond",
     "method": "GET",
     "path": "/?pageIndex=5",
     "description": "Page beyond the end (empty table)"
    },
    {
     "id": "mvc-index-size100",
     "method": "GET",
     "path": "/?pageSize=100",
     "description": "Page size larger than catalog"
    },
    {
     "id": "mvc-index-size1-page11",
     "method": "GET",
     "path": "/?pageSize=1&pageIndex=11",
     "description": "Last single-item page"
    },
    {
     "id": "mvc-index-size0",
     "method": "GET",
     "path": "/?pageSize=0",
     "description": "pageSize=0 -> divide by zero -> 500 (quirk Q5)",
     "quirk": "Q5"
    },
    {
     "id": "mvc-index-negative-page",
     "method": "GET",
     "path": "/?pageIndex=-1",
     "description": "Negative page index (Skip(negative) = first page in mock)"
    },
    {
     "id": "mvc-index-negative-size",
     "method": "GET",
     "path": "/?pageSize=-1",
     "description": "Negative page size (Take(-1) = empty, TotalPages -12)"
    },
    {
     "id": "mvc-index-size-nonnumeric",
     "method": "GET",
     "path": "/?pageSize=abc",
     "description": "Unparsable pageSize -> default 10"
    },
    {
     "id": "mvc-index-page-nonnumeric",
     "method": "GET",
     "path": "/?pageIndex=x",
     "description": "Unparsable pageIndex -> default 0"
    },
    {
     "id": "mvc-details-found",
     "method": "GET",
     "path": "/Catalog/Details/1",
     "description": "Details found"
    },
    {
     "id": "mvc-details-found-12",
     "method": "GET",
     "path": "/Catalog/Details/12",
     "description": "Details of last item (after list render)"
    },
    {
     "id": "mvc-details-missing",
     "method": "GET",
     "path": "/Catalog/Details/999",
     "description": "Unknown id -> 404"
    },
    {
     "id": "mvc-details-no-id",
     "method": "GET",
     "path": "/Catalog/Details",
     "description": "No id -> 400"
    },
    {
     "id": "mvc-details-bad-id",
     "method": "GET",
     "path": "/Catalog/Details/abc",
     "description": "Non-int id binds null -> 400"
    },
    {
     "id": "mvc-details-query-id",
     "method": "GET",
     "path": "/Catalog/Details?id=2",
     "description": "Id from query string"
    },
    {
     "id": "mvc-details-zero",
     "method": "GET",
     "path": "/Catalog/Details/0",
     "description": "Id 0 -> 404"
    },
    {
     "id": "mvc-edit-found",
     "method": "GET",
     "path": "/Catalog/Edit/1",
     "description": "Edit form"
    },
    {
     "id": "mvc-edit-missing",
     "method": "GET",
     "path": "/Catalog/Edit/999",
     "description": "404"
    },
    {
     "id": "mvc-edit-no-id",
     "method": "GET",
     "path": "/Catalog/Edit",
     "description": "400"
    },
    {
     "id": "mvc-edit-bad-id",
     "method": "GET",
     "path": "/Catalog/Edit/abc",
     "description": "400"
    },
    {
     "id": "mvc-delete-found",
     "method": "GET",
     "path": "/Catalog/Delete/1",
     "description": "Delete confirmation"
    },
    {
     "id": "mvc-delete-missing",
     "method": "GET",
     "path": "/Catalog/Delete/999",
     "description": "404"
    },
    {
     "id": "mvc-delete-no-id",
     "method": "GET",
     "path": "/Catalog/Delete",
     "description": "400"
    },
    {
     "id": "mvc-delete-bad-id",
     "method": "GET",
     "path": "/Catalog/Delete/abc",
     "description": "400"
    },
    {
     "id": "mvc-create-get",
     "method": "GET",
     "path": "/Catalog/Create",
     "description": "Create form with brand/type dropdowns"
    },
    {
     "id": "mvc-pic-1",
     "method": "GET",
     "path": "/items/1/pic",
     "description": "Picture via named attribute route"
    },
    {
     "id": "mvc-pic-12",
     "method": "GET",
     "path": "/items/12/pic",
     "description": "Picture of last item"
    },
    {
     "id": "mvc-pic-zero",
     "method": "GET",
     "path": "/items/0/pic",
     "description": "id 0 -> 400"
    },
    {
     "id": "mvc-pic-negative",
     "method": "GET",
     "path": "/items/-1/pic",
     "description": "negative id -> 400"
    },
    {
     "id": "mvc-pic-missing",
     "method": "GET",
     "path": "/items/999/pic",
     "description": "unknown -> 404"
    },
    {
     "id": "mvc-pic-nonnumeric",
     "method": "GET",
     "path": "/items/abc/pic",
     "description": "route constraint fails -> 404"
    },
    {
     "id": "mvc-api-brands",
     "method": "GET",
     "path": "/api/brands",
     "description": "Brand list JSON"
    },
    {
     "id": "mvc-api-brands-xml",
     "method": "GET",
     "path": "/api/brands",
     "description": "Content negotiation: XML",
     "headers": {
      "Accept": "application/xml"
     },
     "quirk": "Q16"
    },
    {
     "id": "mvc-api-brand-1",
     "method": "GET",
     "path": "/api/brands/1",
     "description": "Brand by id"
    },
    {
     "id": "mvc-api-brand-5",
     "method": "GET",
     "path": "/api/brands/5",
     "description": "Brand by id (last)"
    },
    {
     "id": "mvc-api-brand-missing",
     "method": "GET",
     "path": "/api/brands/99",
     "description": "404"
    },
    {
     "id": "mvc-api-brand-nonnumeric",
     "method": "GET",
     "path": "/api/brands/abc",
     "description": "Non-int id"
    },
    {
     "id": "mvc-api-files",
     "method": "GET",
     "path": "/api/files",
     "description": "BinaryFormatter brand list; compared semantically (brand names); target must return JSON (quirk Q2)",
     "compare": "brands-semantic",
     "quirk": "Q2"
    },
    {
     "id": "mvc-api-root-undiscovered",
     "method": "GET",
     "path": "/api",
     "description": "CatalogController2 is never discovered -> 404 (quirk Q1)"
    },
    {
     "id": "mvc-unknown-path",
     "method": "GET",
     "path": "/does-not-exist",
     "description": "Unknown path -> 404"
    },
    {
