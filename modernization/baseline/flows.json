     "compare": "status"
    }
   ]
  },
  {
   "id": "mvc-create",
   "app": "mvc",
   "restart": true,
   "flows": [
    {
     "id": "mvc-create-post-valid",
     "method": "POST",
     "description": "Valid create -> 302 / ; new id 13",
     "form": {
      "page": "/Catalog/Create",
      "fields": {
       "Name": "Parity Test Hoodie",
       "Description": "Created by the parity harness",
       "Price": "24.99",
       "CatalogBrandId": "3",
       "CatalogTypeId": "2",
       "AvailableStock": "42",
       "RestockThreshold": "5",
       "MaxStockThreshold": "200",
       "PictureFileName": "dummy.png"
      }
     },
     "snapshot": true
    },
    {
     "id": "mvc-create-after-list",
     "method": "GET",
     "path": "/?pageSize=20",
     "description": "List shows the new item"
    },
    {
     "id": "mvc-create-after-details",
     "method": "GET",
     "path": "/Catalog/Details/13",
     "description": "Details of the created item"
    }
   ]
  },
