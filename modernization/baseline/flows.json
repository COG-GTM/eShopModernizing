     "path": "/Scripts/jquery.validate.js",
     "description": "Validation script"
    },
    {
     "id": "mvc-static-jquery-validate-unobtrusive",
     "method": "GET",
     "path": "/Scripts/jquery.validate.unobtrusive.js",
     "description": "Validation script"
    },
    {
     "id": "mvc-static-modernizr",
     "method": "GET",
     "path": "/Scripts/modernizr-2.8.3.js",
     "description": "Script"
    },
    {
     "id": "mvc-static-bootstrap-js",
     "method": "GET",
     "path": "/Scripts/bootstrap.js",
     "description": "Script"
    },
    {
     "id": "mvc-static-respond-js",
     "method": "GET",
     "path": "/Scripts/respond.js",
     "description": "Script"
    },
    {
     "id": "mvc-bundle-css",
     "method": "GET",
     "path": "/Content/css",
     "description": "Optimisation bundle URL (not referenced in debug pages): status + type only",
     "compare": "status"
    },
    {
     "id": "mvc-bundle-jquery",
     "method": "GET",
     "path": "/bundles/jquery",
     "description": "bundle: status + type only",
     "compare": "status"
    },
    {
     "id": "mvc-bundle-jqueryval",
     "method": "GET",
     "path": "/bundles/jqueryval",
     "description": "bundle",
     "compare": "status"
    },
