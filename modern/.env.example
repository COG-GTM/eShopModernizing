# Copy to modern/.env (git-ignored) and set your own values. Never commit real secrets.
# SQL Server 2022 sa password: at least 8 chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
# Host ports (container port is always 8080).
CATALOG_MVC_PORT=5300
CATALOG_WEBFORMS_PORT=5301
CATALOG_MVC_MOCK_PORT=5310
CATALOG_WEBFORMS_MOCK_PORT=5311
SQLSERVER_PORT=5433
