@page "{id}"
@model DetailsModel
@{
    ViewData["Title"] = "Details";
    ViewData[LegacyPage.PageFormKey] = true;
}
<h2 class="esh-body-title">Details</h2>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src="/Pics/@Model.Item.PictureFileName" />
        <dl class="col-md-6 dl-horizontal">
            <partial name="_CatalogItemFields" model="Model.Item" />
        </dl>
    </div>

    <div class="form-actions no-color esh-link-list">
        <a class="esh-link-item" href="/Catalog/Edit/@Model.Item.Id">Edit
        </a>
        |
        <a class="esh-link-item" href="@LegacyPage.AppRootRelativeTo(HttpContext.Request.Path)">Back to list
        </a>
    </div>

</div>
