@model eShop.Catalog.Mvc.Models.CatalogItemInputModel
@using eShop.Catalog.Mvc.Html

@{
    ViewBag.Title = "Create";
}

<h2 class="esh-body-title">Create</h2>


<!form action="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" method="post">
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.LegacyValidationSummary("text-danger")
        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CatalogBrandId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.DropDownList("CatalogBrandId", null, htmlAttributes: new { @class = "form-control" }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.CatalogBrandId, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.CatalogTypeId, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.DropDownList("CatalogTypeId", null, htmlAttributes: new { @class = "form-control" }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.CatalogTypeId, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control" } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.PictureFileName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AvailableStock, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.AvailableStock, new { htmlAttributes = new { @class = "form-control", data_val_number = "The field Stock must be a number." } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.AvailableStock, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.RestockThreshold, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.RestockThreshold, new { htmlAttributes = new { @class = "form-control", data_val_number = "The field Restock must be a number." } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.RestockThreshold, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MaxStockThreshold, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-3">
                @(Html.EditorFor(model => model.MaxStockThreshold, new { htmlAttributes = new { @class = "form-control", data_val_number = "The field Max stock must be a number." } }).WithLegacyMarkup())
                @Html.ValidationMessageFor(model => model.MaxStockThreshold, "", new { @class = "text-danger" }).WithLegacyMarkup()
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a class="btn esh-button esh-button-secondary" href="@Url.Content("~/")">[ Cancel ]</a>
                <input type="submit" value="[ Create ]" class="btn esh-button esh-button-primary" />
            </div>
        </div>
    </div>
</!form>

<div>
    
</div>

@section Scripts {
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
}
